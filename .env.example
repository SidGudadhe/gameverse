# GameVerse Environment Configuration

# Authentication & Sessions
JWT_SECRET="gameverse-production-super-secret-jwt-key-2026"
SESSION_SECRET="gameverse-secure-session-encryption-key-2026"
SESSION_TTL_SECONDS=604800 # 7 days

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gameverse?schema=public"

# Admin 2FA
ADMIN_2FA_ISSUER="GameVerse Security"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000 # 1 minute
RATE_LIMIT_MAX_REQUESTS=100

# File Storage & Sandbox Origins
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SANDBOX_ORIGIN="http://localhost:5001"
