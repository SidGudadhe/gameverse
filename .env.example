# GameVerse Environment Configuration

# Authentication & Sessions
JWT_SECRET="gameverse-production-super-secret-jwt-key-2026"
SESSION_SECRET="gameverse-secure-session-encryption-key-2026"
SESSION_TTL_SECONDS=604800 # 7 days

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gameverse?schema=public"

# Admin 2FA
ADMIN_2FA_ISSUER="GameVerse Security"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000 # 1 minute
RATE_LIMIT_MAX_REQUESTS=100

# File Storage & Sandbox Origins
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SANDBOX_ORIGIN="http://localhost:5001"

# GameVerse Game Hosting & Global CDN Delivery Configuration
# Provider: cloudflare_r2 | aws_s3 | local_isolated
GAMEVERSE_STORAGE_PROVIDER="cloudflare_r2"

# Cloudflare R2 Credentials & Storage Bucket
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="gameverse-production-games"

# Global CDN Delivery & Serving Domains
# R2_PUBLIC_DOMAIN: Direct static asset edge CDN (Zero egress fees via Cloudflare)
R2_PUBLIC_DOMAIN="https://cdn.gameverse.com"
# GAME_SERVING_DOMAIN: Isolated player sandbox domain for running untrusted HTML5 games
GAME_SERVING_DOMAIN="https://play.gameverse.com"

# Maximum Game ZIP Bundle Upload Size (bytes, default 100MB)
MAX_GAME_ZIP_BYTES=104857600

# AWS S3 Alternative Configuration (Optional Fallback)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
CLOUDFRONT_DOMAIN=""

# Google OAuth & Identity Services Configuration (Player Single Sign-On & One Tap)
# (Paste your real Web Client ID & Secret from Google Cloud Console below)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
